{
  "name": "vael-form",
  "version": "0.0.2",
  "description": "Vue-first forms on Standard Schema, with v-model, i18n and accessibility built in; works in VDOM and Vapor.",
  "keywords": [
    "arktype",
    "form",
    "forms",
    "i18n",
    "nuxt",
    "standard-schema",
    "v-model",
    "valibot",
    "validation",
    "vapor",
    "vue",
    "vue3",
    "zod"
  ],
  "homepage": "https://github.com/Mini-Sylar/vael-form#readme",
  "bugs": {
    "url": "https://github.com/Mini-Sylar/vael-form/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Mini-Sylar/vael-form.git",
    "directory": "packages/vael-form"
  },
  "funding": "https://github.com/sponsors/Mini-Sylar",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./nuxt": "./dist/nuxt.js",
    "./runtime/plugin": "./dist/runtime/plugin.js",
    "./validator": "./dist/validator.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown && node -e \"const fs = require('fs'); fs.copyFileSync('../../README.md', './README.md'); fs.copyFileSync('../../LICENSE', './LICENSE')\"",
    "dev": "tsdown --watch --no-clean",
    "test": "pnpm test:vdom && pnpm test:vapor && pnpm test:interop",
    "typecheck": "vue-tsc --noEmit",
    "size": "rm -rf .size && tsdown --minify --no-dts --no-exports --no-publint --no-attw --out-dir .size && node ../../scripts/check-size.mjs",
    "test:vdom": "MODE=vdom vitest run --passWithNoTests",
    "test:vapor": "MODE=vapor vitest run",
    "test:interop": "MODE=interop vitest run",
    "prepack": "pnpm build"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:schemas"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "catalog:dev",
    "@nuxt/kit": "catalog:dev",
    "@nuxt/schema": "catalog:dev",
    "@vitejs/plugin-vue": "catalog:dev",
    "@vitest/browser-playwright": "catalog:dev",
    "arktype": "catalog:schemas",
    "effect": "catalog:schemas",
    "joi": "catalog:schemas",
    "pinia": "catalog:frontend",
    "playwright": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "valibot": "catalog:schemas",
    "vite": "catalog:dev",
    "vitest": "catalog:dev",
    "vitest-browser-vue": "catalog:dev",
    "vue": "catalog:frontend",
    "vue-i18n": "catalog:frontend",
    "vue-tsc": "catalog:dev",
    "yup": "catalog:schemas",
    "zod": "catalog:schemas"
  },
  "peerDependencies": {
    "@nuxt/kit": "^3.15.0 || ^4.0.0",
    "vue": "^3.5.0 || ^3.6.0-0"
  },
  "peerDependenciesMeta": {
    "@nuxt/kit": {
      "optional": true
    }
  }
}
